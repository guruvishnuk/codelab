# CodeLab Backend Environment Configuration

# Database Connection URL (SQLite default or PostgreSQL)
DATABASE_URL=sqlite:///./codelab.db
# DATABASE_URL=postgresql+psycopg2://codelab:codelab_password@localhost:5432/codelab

# Allowed CORS Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000,https://codelab-amber.vercel.app

# Shared Secret for JWT Auth Token Verification (must match Next.js AUTH_SECRET)
AUTH_SECRET=9b7f8e3d2c1a4f6e8b0d7c5a3f2e1d0c

# Welcome Email / SMTP Configuration (leave blank for local console preview mode)
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use a 16-char Google App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CodeLab <no-reply@codelab.dev>
APP_URL=http://localhost:3000
# Set to "true" to send the welcome email on every login instead of only first login
WELCOME_EMAIL_ON_EVERY_LOGIN=false
